<?xml version="1.0" encoding="UTF-8" ?> <!-- Defines XML version and char encoding -->

<configuration>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern = "%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} %msg%n"/>
        </Console>
        <RollingFile name="File"
                     fileName="logs/application.log"
                     filePattern="logs/application-%d{yyyy-MM-dd}.log.gz" >

            <PatternLayout
                    pattern = "%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} %msg%n"/>

            <Policies>
                <TimeBasedTriggerPolicy/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</configuration>

<!--
In production we generally create a log4j2.xml or log4j2-spring.xml file to configure log levels, log patterns, file appenders, rolling policies and separate logging for
diff packages. This gives better monitoring, troubleshoorting and log management.

Appenders - (Logger -> Appender -> Destination) Where logs are written like Console, File, Database, Kafka, Remote server
Layouts - how log looks
Loggers - What logs are written


-->